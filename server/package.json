{
  "name": "team-caltalk-server",
  "version": "0.1.0",
  "private": true,
  "description": "Team CalTalk backend (Express + pg, raw SQL)",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node-pg-migrate --envPath ../.env -m src/db/migrations",
    "migrate:up": "node-pg-migrate up --envPath ../.env -m src/db/migrations",
    "migrate:down": "node-pg-migrate down --envPath ../.env -m src/db/migrations",
    "migrate:create": "node-pg-migrate create --envPath ../.env -m src/db/migrations",
    "seed": "node src/db/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:verify-indexes": "node src/db/verify-indexes.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.9",
    "node-pg-migrate": "^7.9.1",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
