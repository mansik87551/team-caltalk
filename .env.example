# ─── Application ──────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/team_caltalk
PORT=3000

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=team_caltalk

# 커넥션 풀(pg.Pool) 설정 — 선택(미설정 시 기본값 사용: max=10, idle=30000, conn=5000)
POSTGRES_POOL_MAX=10
POSTGRES_POOL_IDLE_MS=30000
POSTGRES_POOL_CONN_TIMEOUT_MS=5000

# ─── postgresql-mcp (로컬 DB 연결용) ─────────────────────────
POSTGRES_CONNECTION_STRING=postgresql://USER:PASSWORD@localhost:5432/team_caltalk

# ─── Auth / Security (BE-01) ──────────────────────────────────
# JWT_ACCESS_SECRET 은 필수다. 누락 시 부팅 즉시 실패한다. 운영에서는 32자 이상 난수로 교체.
JWT_ACCESS_SECRET=change-me-please-use-a-long-random-secret
# 액세스 토큰 만료(선택, 기본 15m)
JWT_ACCESS_TTL=15m
# CORS 허용 오리진 화이트리스트(쉼표 구분, 선택). 프로덕션 와일드카드 금지.
CORS_ORIGIN=http://localhost:5173
# pino 로그 레벨(선택, 기본 info)
LOG_LEVEL=info
